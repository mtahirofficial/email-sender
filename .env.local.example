# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> service_role (server-only, NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
# Base URL of this app, no trailing slash (used to build OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte key (64 hex chars) used to encrypt stored OAuth tokens at rest.
# Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register in Google Cloud Console:
# {NEXT_PUBLIC_APP_URL}/oauth/google/callback

# ---- Microsoft OAuth (Azure Portal -> App registrations) ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Redirect URI to register in Azure Portal:
# {NEXT_PUBLIC_APP_URL}/oauth/microsoft/callback
