# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> service_role (server-only, NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
# Base URL of this app, no trailing slash (used to build OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public contact address shown on the Privacy Policy, Terms and footer.
# Set this before going live (Google OAuth verification expects one).
NEXT_PUBLIC_CONTACT_EMAIL=

# 32-byte key (64 hex chars) used to encrypt stored OAuth tokens at rest.
# Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register in Google Cloud Console:
# {NEXT_PUBLIC_APP_URL}/oauth/google/callback

# ---- Microsoft OAuth (Azure Portal -> App registrations) ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Redirect URI to register in Azure Portal:
# {NEXT_PUBLIC_APP_URL}/oauth/microsoft/callback

# ---- Admin ----
# Only this (email-confirmed) account can use admin-only tools.
# Defaults to the project owner's address if left unset.
ADMIN_EMAIL=

# ---- AI drafting ("Generate with AI") ----
# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
# Set at least one. Groq is tried first, Gemini is the fallback. The button stays
# disabled ("Coming soon") until one key is set.
GROQ_API_KEY=
GEMINI_API_KEY=
# Leave these blank: the newest suitable model is detected automatically.
# Only set one to force a specific model.
GROQ_MODEL=
GEMINI_MODEL=
# Drafts one user may generate per day (default 100).
AI_DAILY_LIMIT=100
